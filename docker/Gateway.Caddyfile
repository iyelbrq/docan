{
	auto_https off

	servers {
		# cloudflared terhubung dari jaringan container memakai IP privat dan
		# meneruskan IP pelanggan asli lewat header Cloudflare. Percayai peer
		# privat lalu ambil IP client dari Cf-Connecting-Ip / X-Forwarded-For.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	reverse_proxy {
		dynamic a {
			name app
			port 80
			refresh 5s
		}
		lb_policy round_robin
		health_uri /up
		health_interval 10s
		fail_duration 15s
		max_fails 3

		# Kirim IP pelanggan asli + skema HTTPS ke aplikasi Laravel supaya
		# rate limit dihitung per kasir dan url() memakai https (bukan mixed content).
		header_up X-Forwarded-For {http.request.client_ip}
		header_up X-Forwarded-Proto https
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
